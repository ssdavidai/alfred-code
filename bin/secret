#!/usr/bin/env bash
# secret — fetch a registered secret from the broker (Keychain primary).
#
# The whole point: lets Claude (or you) use secret values inline without
# ever echoing them to conversation or shell logs.
#
# Usage:
#   secret get <name>         # print value to stdout, nothing else
#   secret has <name>         # exit 0 if present, 1 if not (no output)
#   secret list               # print all registered NAMES that are set
#   secret names              # print all CANONICAL names (set or not)
#   secret where <name>       # print "keychain" / "1password" / "missing"
#
# Inline pattern (this is how Claude should use it):
#   curl -H "Authorization: Bearer $(secret get cloudflare-api-token)" ...
#
# Resolution order:
#   1. macOS Keychain (`security find-generic-password -s ALFRED_SECRET_<name> -w`)
#   2. 1Password CLI fallback if registered via 1PASSWORD_REFS lookup
#
# Hard rule: this script NEVER writes the value to stderr, never to a log
# file, never to an env var that survives the process. Just stdout, once.

set -euo pipefail

ALFRED_SECRETS_HOME="${ALFRED_SECRETS_HOME:-$HOME/.claude/alfred-code}"
REGISTRY="${ALFRED_SECRETS_HOME}/docs/secrets-registry.md"
ONEPW_REFS="${HOME}/.alfred-code-state/onepassword-refs.txt"
SERVICE_PREFIX="ALFRED_SECRET_"

die() { printf '%s\n' "$*" >&2; exit 1; }

# ── canonical names (kept in sync with docs/secrets-registry.md) ────
canonical_names() {
  cat <<'NAMES'
cloudflare-api-token
hetzner-api-token
tailscale-api-key
openrouter-api-key
openai-api-key
anthropic-api-key
groq-api-key
paperclip-api-key
pypi-token
acme-email
vaultwarden-master
github-pat
telegram-bot-token
telegram-chat-id
NAMES
}

is_canonical() {
  local name="$1"
  canonical_names | grep -qx "$name"
}

keychain_get() {
  local name="$1"
  security find-generic-password \
    -s "${SERVICE_PREFIX}${name}" -w 2>/dev/null
}

keychain_has() {
  local name="$1"
  security find-generic-password \
    -s "${SERVICE_PREFIX}${name}" >/dev/null 2>&1
}

onepassword_get() {
  local name="$1"
  local ref
  ref=$(grep -E "^${name}=" "$ONEPW_REFS" 2>/dev/null | cut -d= -f2-)
  [[ -z "$ref" ]] && return 1
  command -v op >/dev/null 2>&1 || return 1
  op read "$ref" 2>/dev/null
}

onepassword_has() {
  local name="$1"
  [[ -f "$ONEPW_REFS" ]] || return 1
  grep -qE "^${name}=" "$ONEPW_REFS" && command -v op >/dev/null 2>&1
}

cmd_get() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "usage: secret get <name>"
  is_canonical "$name" || die "unknown secret name: $name (run: secret names)"
  local val
  if val=$(keychain_get "$name") && [[ -n "$val" ]]; then
    printf '%s' "$val"
    return 0
  fi
  if val=$(onepassword_get "$name") && [[ -n "$val" ]]; then
    printf '%s' "$val"
    return 0
  fi
  die "secret '$name' not found. Run /secrets-bootstrap to set it."
}

cmd_has() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "usage: secret has <name>"
  keychain_has "$name" || onepassword_has "$name"
}

cmd_list() {
  while IFS= read -r name; do
    if keychain_has "$name"; then
      printf '%s\n' "$name"
    elif onepassword_has "$name"; then
      printf '%s (1password)\n' "$name"
    fi
  done < <(canonical_names)
}

cmd_names() {
  canonical_names
}

cmd_where() {
  local name="${1:-}"
  [[ -z "$name" ]] && die "usage: secret where <name>"
  if keychain_has "$name"; then
    echo "keychain"
  elif onepassword_has "$name"; then
    echo "1password"
  else
    echo "missing"
  fi
}

case "${1:-}" in
  get)   shift; cmd_get "$@" ;;
  has)   shift; cmd_has "$@" ;;
  list)  cmd_list ;;
  names) cmd_names ;;
  where) shift; cmd_where "$@" ;;
  ""|-h|--help)
    sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//;s/^set -euo.*//' | sed '/^$/N;/\n$/d'
    ;;
  *) die "unknown subcommand: $1 (try: get has list names where)" ;;
esac
