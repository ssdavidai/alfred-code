#!/usr/bin/env bash
# secret-set — write a secret to macOS Keychain (admin tool, you-only).
#
# This is the ONLY script that writes secret values. Claude should not
# call it autonomously — it's run by you during /secrets-bootstrap.
#
# Usage:
#   secret-set <name>                  # prompt for value (silent read)
#   secret-set <name> --from-stdin     # read value from stdin (1Password pipe)
#   secret-set <name> --from-env VAR   # read value from env var (then unset)
#   secret-set <name> --1password "<op-ref>"   # store an `op read` ref, no value lands on disk
#
# Examples:
#   secret-set cloudflare-api-token
#   echo "$TOKEN" | secret-set hetzner-api-token --from-stdin
#   secret-set anthropic-api-key --1password "op://Personal/Anthropic/credential"

set -euo pipefail

ALFRED_SECRETS_HOME="${ALFRED_SECRETS_HOME:-$HOME/.claude/alfred-code}"
ONEPW_REFS="${HOME}/.alfred-code-state/onepassword-refs.txt"
SERVICE_PREFIX="ALFRED_SECRET_"

die()  { printf '%s\n' "$*" >&2; exit 1; }
warn() { printf '%s\n' "$*" >&2; }

canonical_names() {
  bash "${ALFRED_SECRETS_HOME}/bin/secret" names
}

is_canonical() {
  canonical_names | grep -qx "$1"
}

write_keychain() {
  local name="$1" value="$2"
  security add-generic-password \
    -s "${SERVICE_PREFIX}${name}" \
    -a "${USER}" \
    -w "${value}" \
    -U >/dev/null
  warn "  ✓ stored $name in Keychain"
}

write_onepw_ref() {
  local name="$1" ref="$2"
  mkdir -p "$(dirname "$ONEPW_REFS")"
  touch "$ONEPW_REFS"
  chmod 600 "$ONEPW_REFS"
  # remove any existing line for this name
  grep -v "^${name}=" "$ONEPW_REFS" > "$ONEPW_REFS.tmp" || true
  mv "$ONEPW_REFS.tmp" "$ONEPW_REFS"
  printf '%s=%s\n' "$name" "$ref" >> "$ONEPW_REFS"
  warn "  ✓ registered 1Password ref for $name"
}

NAME="${1:-}"
[[ -z "$NAME" ]] && die "usage: secret-set <name> [--from-stdin | --from-env VAR | --1password REF]"
is_canonical "$NAME" || die "unknown secret name: $NAME (try: secret names)"
shift

MODE="prompt"
SRC=""
case "${1:-}" in
  --from-stdin)        MODE="stdin"; shift ;;
  --from-env)          MODE="env"; SRC="${2:?env var name required}"; shift 2 ;;
  --1password)         MODE="1pw"; SRC="${2:?op ref required}"; shift 2 ;;
  "") ;;
  *) die "unknown flag: $1" ;;
esac

case "$MODE" in
  prompt)
    printf "  Value for %s (input hidden): " "$NAME" >&2
    IFS= read -rs VALUE
    echo >&2
    [[ -z "$VALUE" ]] && die "empty value, aborting"
    write_keychain "$NAME" "$VALUE"
    unset VALUE
    ;;
  stdin)
    VALUE=$(cat)
    [[ -z "$VALUE" ]] && die "empty stdin, aborting"
    write_keychain "$NAME" "$VALUE"
    unset VALUE
    ;;
  env)
    VALUE="${!SRC:-}"
    [[ -z "$VALUE" ]] && die "env var \$$SRC is empty"
    write_keychain "$NAME" "$VALUE"
    unset "$SRC"
    unset VALUE
    ;;
  1pw)
    write_onepw_ref "$NAME" "$SRC"
    ;;
esac
