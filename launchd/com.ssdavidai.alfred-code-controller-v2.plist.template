<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ssdavidai.alfred-code-controller-v2</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.claude/bin/alfred-code-daemon</string>
    <string>--config</string>
    <string>__HOME__/.config/alfred-code/controller.toml</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>__HOME__/dev/alfred</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.alfred-code-state-v2/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.alfred-code-state-v2/launchd.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:__HOME__/.claude/bin:__HOME__/.superset/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
